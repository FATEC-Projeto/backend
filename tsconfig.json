{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],  
    "typeRoots": [
      "./node_modules/@types",   
      "./src/types"              
    ]
  },
  "include": ["src"],  
  "exclude": ["node_modules", "dist", "tests","jest.setup.ts"]
}
