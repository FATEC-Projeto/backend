generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * ---------- ENUMS ----------
 */
enum Papel {
  USUARIO
  BACKOFFICE
  TECNICO
  ADMINISTRADOR
}

enum NivelChamado {
  N1
  N2
  N3
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO_USUARIO
  RESOLVIDO
  ENCERRADO
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

/**
 * ---------- ORGANIZAÇÃO / SETORES / CATÁLOGO ----------
 */
model Organizacao {
  id       String   @id @default(cuid())
  nome     String
  sigla    String?
  criadoEm DateTime @default(now())

  usuarios     Usuario[]
  setores      Setor[]
  categorias   Categoria[]
  chamados     Chamado[]
  notificacoes Notificacao[] @relation("NotificacoesDaOrganizacao")

  @@map("organizacoes")
}

model Setor {
  id            String       @id @default(cuid())
  organizacaoId String?
  nome          String
  descricao     String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  usuarioSetores UsuarioSetor[]
  chamados       Chamado[]

  @@index([organizacaoId])
  @@map("setores")
}

model PapelCatalogo {
  id        String  @id @default(cuid())
  nome      String  @unique
  descricao String?

  usuarioSetores UsuarioSetor[]

  @@map("papeis")
}

model UsuarioSetor {
  id        String   @id @default(cuid())
  usuarioId String
  setorId   String
  papelId   String?
  criadoEm  DateTime @default(now())

  usuario Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  setor   Setor          @relation(fields: [setorId], references: [id], onDelete: Cascade)
  papel   PapelCatalogo? @relation(fields: [papelId], references: [id])

  @@unique([usuarioId, setorId, papelId])
  @@index([setorId])
  @@map("usuarios_setores")
}

model Categoria {
  id            String       @id @default(cuid())
  organizacaoId String?
  nome          String
  descricao     String?
  organizacao   Organizacao? @relation(fields: [organizacaoId], references: [id])

  servicos Servico[]

  @@index([organizacaoId])
  @@map("categorias")
}

model Servico {
  id          String     @id @default(cuid())
  categoriaId String?
  nome        String
  descricao   String?
  ativo       Boolean    @default(true)
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  chamados Chamado[]

  @@index([categoriaId])
  @@map("servicos")
}

/**
 * ---------- USUÁRIOS & SESSÕES ----------
 */
model Usuario {
  id               String    @id @default(cuid())
  organizacaoId    String?
  cursoNome        String?   
  cursoSigla       String?   @db.VarChar(16) 
  nome             String
  emailPessoal     String    @unique
  emailEducacional String?
  ra               String?   @unique @db.VarChar(32)
  senhaHash        String
  papel            Papel     @default(USUARIO)
  ativo            Boolean   @default(true)
  anonimizado      Boolean   @default(false)
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt
  deletadoEm       DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  lastFailedAttempt DateTime?

  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id])

  chamadosCriados    Chamado[]                @relation("ChamadosCriados")
  chamadosAtribuidos Chamado[]                @relation("ChamadosAtribuidos")
  anexos             Anexo[]
  auditorias         Auditoria[]
  mensagens          Mensagem[]
  mudancasStatus     HistoricoStatusChamado[] @relation("StatusPorUsuario")
  sessoes            Sessao[]
  tokensReset        TokenResetSenha[]        @relation("TokensDeUsuario")
  usuarioSetores     UsuarioSetor[]
  loginTentativas    LoginTentativa[]         @relation("LoginTentativasDoUsuario")
  notificacoes       Notificacao[]            @relation("NotificacoesDoUsuario")

  @@index([emailPessoal])
  @@index([organizacaoId])
  @@index([cursoSigla])
  @@map("usuarios")
}

model Sessao {
  id          String   @id @default(cuid()) // pode servir como JTI
  usuarioId   String
  refreshHash String   @db.VarChar(255)
  userAgent   String?
  ip          String?  @db.VarChar(64)
  expiraEm    DateTime
  criadoEm    DateTime @default(now())

  ultimoUsoEm      DateTime  @default(now())
  revogadaEm       DateTime?
  substituidaPorId String?
  substituidaPor   Sessao?   @relation("SessaoSubstituta", fields: [substituidaPorId], references: [id])
  substitui        Sessao[]  @relation("SessaoSubstituta")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([refreshHash])
  @@index([usuarioId])
  @@index([expiraEm])
  @@index([revogadaEm])
  @@map("sessoes")
}

model TokenResetSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuario   Usuario   @relation("TokensDeUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("tokens_reset_senha")
}

/**
 * ---------- CLIENTES & CONTRATOS (Backoffice) ----------
 */
model Cliente {
  id           String    @id @default(cuid())
  nome         String
  cpf          String?   @unique @db.VarChar(14)
  email        String?
  telefone     String?   @db.VarChar(20)
  idExterno    String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?

  contratos Contrato[]
  chamados  Chamado[]

  @@index([nome])
  @@index([cpf])
  @@map("clientes")
}

model Contrato {
  id           String    @id @default(cuid())
  clienteId    String
  numero       String    @db.VarChar(64)
  plano        String?
  dataInicio   DateTime?
  dataFim      DateTime?
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?
  cliente      Cliente   @relation(fields: [clienteId], references: [id])

  chamados Chamado[] @relation("ChamadosDoContrato")

  @@unique([clienteId, numero])
  @@index([clienteId])
  @@map("contratos")
}

/**
 * ---------- CHAMADOS ----------
 */
model Chamado {
  id            String            @id @default(cuid())
  organizacaoId String?
  protocolo     String?           @unique
  titulo        String
  descricao     String
  nivel         NivelChamado      @default(N1)
  status        StatusChamado     @default(ABERTO)
  prioridade    PrioridadeChamado @default(MEDIA)

  servicoId String?
  setorId   String?

  clienteId  String?
  contratoId String?

  responsavelId String?
  criadoPorId   String

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  encerradoEm  DateTime?
  deletadoEm   DateTime?

  organizacao Organizacao? @relation(fields: [organizacaoId], references: [id])
  servico     Servico?     @relation(fields: [servicoId], references: [id])
  setor       Setor?       @relation(fields: [setorId], references: [id])
  cliente     Cliente?     @relation(fields: [clienteId], references: [id])
  contrato    Contrato?    @relation("ChamadosDoContrato", fields: [contratoId], references: [id])
  responsavel Usuario?     @relation("ChamadosAtribuidos", fields: [responsavelId], references: [id])
  criadoPor   Usuario      @relation("ChamadosCriados", fields: [criadoPorId], references: [id])

  anexos       Anexo[]
  historico    HistoricoStatusChamado[]
  mensagens    Mensagem[]
  tags         ChamadoTag[]
  notificacoes Notificacao[]            @relation("NotificacoesDoChamado")

  @@index([status, nivel])
  @@index([criadoEm])
  @@index([clienteId])
  @@index([setorId])
  @@index([servicoId])
  @@index([organizacaoId])
  @@map("chamados")
}

model HistoricoStatusChamado {
  id           String         @id @default(cuid())
  chamadoId    String
  de           StatusChamado?
  para         StatusChamado
  porUsuarioId String?
  observacao   String?
  criadoEm     DateTime       @default(now())
  chamado      Chamado        @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  porUsuario   Usuario?       @relation("StatusPorUsuario", fields: [porUsuarioId], references: [id])

  @@index([chamadoId])
  @@index([criadoEm])
  @@map("historico_status_chamado")
}

model Mensagem {
  id           String    @id @default(cuid())
  chamadoId    String
  autorId      String
  conteudo     String
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  deletadoEm   DateTime?
  chamado      Chamado   @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autor        Usuario   @relation(fields: [autorId], references: [id])

  notificacoes Notificacao[] @relation("NotificacoesDaMensagem")

  @@index([chamadoId])
  @@map("mensagens")
}

model Anexo {
  id             String  @id @default(cuid())
  chamadoId      String
  nomeArquivo    String
  mimeType       String
  tamanhoBytes   Int
  caminhoArquivo String
  storageBucket  String? @default("anexos")
  checksumSha256 String? @db.VarChar(64)

  enviadoPorId String
  enviadoEm    DateTime @default(now())
  chamado      Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  enviadoPor   Usuario  @relation(fields: [enviadoPorId], references: [id])

  notificacoes Notificacao[] @relation("NotificacoesDoAnexo")

  @@index([chamadoId])
  @@map("anexos")
}

/**
 * ---------- TAGS ----------
 */
model Tag {
  id       String       @id @default(cuid())
  nome     String       @unique
  cor      String?      @db.VarChar(16)
  criadoEm DateTime     @default(now())
  chamados ChamadoTag[]

  @@map("tags")
}

model ChamadoTag {
  chamadoId String
  tagId     String
  chamado   Chamado @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([chamadoId, tagId])
  @@index([tagId])
  @@map("chamados_tags")
}

/**
 * ---------- AUDITORIA & E-MAILS ----------
 */
model Auditoria {
  id         String   @id @default(cuid())
  feitoPorId String?
  acao       String
  alvo       String?
  meta       Json?
  feitoEm    DateTime @default(now())
  feitoPor   Usuario? @relation(fields: [feitoPorId], references: [id])

  @@index([feitoEm])
  @@map("auditoria")
}

model EmailEnvio {
  id            String    @id @default(cuid())
  destinatario  String
  assunto       String
  payload       Json
  providerMsgId String?
  status        String    @default("pendente")
  erro          String?
  criadoEm      DateTime  @default(now())
  enviadoEm     DateTime?

  @@index([status])
  @@map("email_envios")
}

/**
 * ---------- LOGIN (AUDITORIA) ----------
 */
model LoginTentativa {
  id        String   @id @default(cuid())
  email     String
  usuarioId String?
  sucesso   Boolean
  ip        String?  @db.VarChar(64)
  userAgent String?
  motivo    String?
  criadoEm  DateTime @default(now())

  usuario Usuario? @relation("LoginTentativasDoUsuario", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([email, criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("login_tentativas")
}

/**
 * ---------- NOTIFICAÇÕES ----------
 */
enum TipoNotificacao {
  CHAMADO_CRIADO
  CHAMADO_ATRIBUIDO
  CHAMADO_ATUALIZADO
  STATUS_ALTERADO
  MENSAGEM_NOVA
  ANEXO_NOVO
  SISTEMA
}

enum CanalNotificacao {
  IN_APP
  EMAIL
  PUSH
}

model Notificacao {
  id        String           @id @default(cuid())
  usuarioId String
  titulo    String
  mensagem  String
  tipo      TipoNotificacao
  canal     CanalNotificacao @default(IN_APP)

  organizacaoId String?
  chamadoId     String?
  mensagemId    String?
  anexoId       String?

  entregueEm  DateTime?
  lidaEm      DateTime?
  arquivadaEm DateTime?
  erroEntrega String?
  meta        Json?
  criadoEm    DateTime  @default(now())

  usuario     Usuario      @relation("NotificacoesDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  organizacao Organizacao? @relation("NotificacoesDaOrganizacao", fields: [organizacaoId], references: [id])
  chamado     Chamado?     @relation("NotificacoesDoChamado", fields: [chamadoId], references: [id])
  mensagemRef Mensagem?    @relation("NotificacoesDaMensagem", fields: [mensagemId], references: [id])
  anexoRef    Anexo?       @relation("NotificacoesDoAnexo", fields: [anexoId], references: [id])

  @@index([usuarioId, criadoEm])
  @@index([chamadoId])
  @@index([organizacaoId])
  @@index([tipo, canal])
  @@map("notificacoes")
}
